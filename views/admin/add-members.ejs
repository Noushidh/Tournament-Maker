<div class="max-w-6xl mx-auto p-4 sm:p-8 font-['Inter'] animate-in fade-in duration-700">
    
    <style>
        @keyframes glow-pulse {
            0% { box-shadow: 0 0 5px rgba(16, 185, 129, 0.2); transform: scale(1); }
            50% { box-shadow: 0 0 25px rgba(16, 185, 129, 0.6); transform: scale(1.02); }
            100% { box-shadow: 0 0 5px rgba(16, 185, 129, 0.2); transform: scale(1); }
        }
        .animate-glow-pulse {
            animation: glow-pulse 2s infinite ease-in-out;
        }
    </style>

    <!-- HEADER SECTION -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 mb-12">
        <div class="space-y-4">
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight"><%= tournament.name %></h2>
            <div class="flex flex-wrap items-center gap-4">
                <span class="px-4 py-1 bg-slate-800 text-slate-300 text-xs font-bold uppercase tracking-wider rounded-full border border-white/5">
                    <%= tournament.type %>
                </span>
                <span class="px-4 py-1 bg-emerald-500/10 text-emerald-400 text-xs font-bold uppercase tracking-wider rounded-full border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.1)]">
                    Active
                </span>
                <div class="flex items-center gap-2 text-slate-400 text-xs font-medium border-l border-white/10 pl-4">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                    <%= tournament.players %> Players
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-xs font-medium border-l border-white/10 pl-4">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <%= new Date(tournament.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
            <button id="addPlayerBtn" 
                <%= tournament.members.length >= tournament.players ? 'disabled' : '' %>
                class="w-full sm:w-auto flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-gray-900 px-8 py-4 rounded-xl font-bold transition-all shadow-[0_10px_30px_rgba(16,185,129,0.2)] transform hover:scale-105 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed disabled:transform-none disabled:bg-slate-700 disabled:text-slate-400">
                <span class="text-xl leading-none">+</span>
                Add Player
            </button>
            
            <% 
                const isFull = tournament.members.length >= tournament.players;
                const today = new Date();
                today.setHours(0,0,0,0);
                const isStarted = new Date(tournament.startDate) <= today;
            %>
            <button id="generateMatchesBtn"
                <%= !isFull ? 'disabled' : '' %>
                class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold transition-all border flex items-center justify-center gap-2
                <%= isFull 
                    ? 'bg-emerald-500 text-gray-900 border-emerald-400/20 hover:bg-emerald-400 animate-glow-pulse' 
                    : 'bg-slate-800 text-slate-500 border-white/5 opacity-50 cursor-not-allowed' %>">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                Generate Matches
            </button>
        </div>
    </div>

    <!-- LIMIT INDICATOR -->
    <% if (tournament.members.length >= tournament.players) { %>
        <div class="mb-8 p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center gap-3 animate-in slide-in-from-top duration-500">
            <div class="w-8 h-8 bg-emerald-500/20 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <p class="text-emerald-400 text-sm font-semibold">Tournament reached maximum player capacity! You can now generate matches.</p>
        </div>
    <% } %>

    <!-- NAVIGATION TABS -->
    <div class="mb-10 p-1.5 bg-slate-900/50 w-fit rounded-2xl border border-white/5 flex gap-2">
        <button class="px-8 py-3 bg-slate-800 text-white text-sm font-bold rounded-xl shadow-lg">Players</button>
        <button class="px-8 py-3 text-slate-500 hover:text-white text-sm font-bold transition-colors">Matches</button>
        <button class="px-8 py-3 text-slate-500 hover:text-white text-sm font-bold transition-colors">Standings</button>
    </div>

    <!-- PLAYER CARDS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        
        <% if (tournament.members && tournament.members.length > 0) { %>
            <% tournament.members.forEach(member => { %>
                <% 
                    const initials = member.playerName.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
                %>
                <div class="bg-slate-900/40 backdrop-blur-md border border-white/5 rounded-[2rem] p-6 hover:border-emerald-500/30 transition-all group relative overflow-hidden flex flex-col justify-between h-52 shadow-xl">
                    
                    <!-- Edit Button (Top Right) -->
                    <button type="button" 
                        onclick='handlePlayerEdit(<%- JSON.stringify(member) %>, "<%= tournament._id %>", <%= isStarted %>)'
                        title="Edit Player"
                        class="absolute top-5 right-5 p-2 bg-white/5 hover:bg-blue-500/20 hover:text-blue-400 text-slate-400 rounded-xl transition-all border border-white/5 z-10 group/edit">
                        <svg class="w-4 h-4 transform group-hover/edit:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                    </button>

                    <!-- Card Glow -->
                    <div class="absolute -top-10 -right-10 w-24 h-24 bg-emerald-500/5 blur-3xl group-hover:bg-emerald-500/10 transition-all"></div>
                    
                    <div class="flex items-start gap-4">
                        <div class="w-14 h-14 bg-emerald-500/10 rounded-2xl flex items-center justify-center border border-emerald-500/20 group-hover:scale-110 transition-transform">
                            <span class="text-emerald-400 text-lg font-black tracking-tighter"><%= initials %></span>
                        </div>
                        <div class="flex-1 min-w-0 pr-8">
                            <h4 class="text-white font-bold text-base truncate group-hover:text-emerald-400 transition-colors"><%= member.playerName %></h4>
                            <p class="text-slate-500 text-xs font-medium">Player</p>
                            <p class="text-slate-400 text-[11px] mt-1 font-semibold flex items-center gap-1">
                                <%= member.team %>
                            </p>
                        </div>
                    </div>

                    <% if (!isStarted) { %>
                    <button type="button" 
                        onclick="openDeleteModal('<%= member.playerName %>', '/admin/remove-member/<%= tournament._id %>/<%= member._id %>')"
                        class="w-full bg-white/5 hover:bg-red-500/10 hover:text-red-400 text-slate-500 py-3 rounded-xl text-xs font-bold border border-white/5 hover:border-red-500/20 transition-all flex items-center justify-center gap-2">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        Remove Player
                    </button>
                    <% } %>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full py-20 text-center border-2 border-dashed border-white/5 rounded-[2rem] bg-slate-900/20">
                <p class="text-slate-500 font-medium">No players added yet. Click "+ Add Player" to start.</p>
            </div>
        <% } %>

    </div>
</div>

<!-- Toast Container -->
<div id="toastContainer" class="fixed top-5 right-5 z-[100] flex flex-col gap-3"></div>

<!-- Modals -->
<%- include('../partials/modals/addPlayer', { takenTeams: tournament.members.map(m => m.team) }) %>
<%- include('../partials/modals/confirmDelete') %>

<script>
    // Show Toast Function (Global)
    function showToast(message, type = 'success') {
        const toastContainer = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `flex items-center gap-3 px-6 py-4 rounded-xl shadow-2xl border transition-all duration-500 transform translate-x-full opacity-0 ${
            type === 'success' 
            ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400' 
            : 'bg-red-500/10 border-red-500/20 text-red-400'
        }`;
        
        const icon = type === 'success' 
            ? '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>'
            : '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';

        toast.innerHTML = `${icon} <span class="font-semibold text-sm">${message}</span>`;
        toastContainer.appendChild(toast);

        setTimeout(() => {
            toast.classList.remove('translate-x-full', 'opacity-0');
        }, 10);

        setTimeout(() => {
            toast.classList.add('translate-x-full', 'opacity-0');
            setTimeout(() => toast.remove(), 500);
        }, 4000);
    }

    // Delete Modal Logic
    function openDeleteModal(name, actionUrl) {
        document.getElementById('deletePlayerName').textContent = name;
        document.getElementById('deleteForm').action = actionUrl;
        document.getElementById('deleteConfirmModal').classList.remove('hidden');
    }

    // Player Edit Handler
    function handlePlayerEdit(member, tournamentId, isStarted) {
        if (isStarted) {
            showToast("Cannot edit players after the tournament has started!", "error");
            return;
        }
        if (typeof window.openEditPlayerModal === 'function') {
            window.openEditPlayerModal(member, tournamentId);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const addPlayerBtn = document.getElementById('addPlayerBtn');
        const addPlayerModal = document.getElementById('addPlayerModal');

        if (addPlayerBtn && addPlayerModal) {
            addPlayerBtn.addEventListener('click', () => {
                if (!addPlayerBtn.disabled) {
                    addPlayerModal.classList.remove('hidden');
                }
            });
        }

        // Show Flash Messages
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            showToast('<%= successMessage %>', 'success');
        <% } %>
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            showToast('<%= errorMessage %>', 'error');
        <% } %>
    });
</script>