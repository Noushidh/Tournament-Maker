<div class="max-w-6xl mx-auto p-4 sm:p-8 font-['Inter'] animate-in fade-in duration-700">
    
    <!-- HEADER SECTION -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 mb-12">
        <div class="space-y-4">
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight"><%= tournament.name %></h2>
            <div class="flex flex-wrap items-center gap-4">
                <span class="px-4 py-1 bg-slate-800 text-slate-300 text-xs font-bold uppercase tracking-wider rounded-full border border-white/5">
                    <%= tournament.type %>
                </span>
                <span class="px-4 py-1 bg-emerald-500/10 text-emerald-400 text-xs font-bold uppercase tracking-wider rounded-full border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.1)]">
                    Active
                </span>
                <div class="flex items-center gap-2 text-slate-400 text-xs font-medium border-l border-white/10 pl-4">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                    <%= tournament.players %> Players
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-xs font-medium border-l border-white/10 pl-4">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <%= new Date(tournament.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
            <button class="w-full sm:w-auto flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-gray-900 px-8 py-4 rounded-xl font-bold transition-all shadow-[0_10px_30px_rgba(16,185,129,0.2)] transform hover:scale-105 active:scale-95">
                <span class="text-xl leading-none">+</span>
                Add Player
            </button>
            <button class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-white px-8 py-4 rounded-xl font-bold transition-all border border-white/5">
                Generate Matches
            </button>
        </div>
    </div>

    <!-- NAVIGATION TABS -->
    <div class="mb-10 p-1.5 bg-slate-900/50 w-fit rounded-2xl border border-white/5 flex gap-2">
        <button class="px-8 py-3 bg-slate-800 text-white text-sm font-bold rounded-xl shadow-lg">Players</button>
        <button class="px-8 py-3 text-slate-500 hover:text-white text-sm font-bold transition-colors">Matches</button>
        <button class="px-8 py-3 text-slate-500 hover:text-white text-sm font-bold transition-colors">Standings</button>
    </div>

    <!-- PLAYER CARDS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        
        <% 
            const dummyPlayers = [
                { initials: 'AM', name: 'Arjun Menon', handle: '@arjun_pro', team: '🇦🇷 Argentina' },
                { initials: 'RK', name: 'Rahul Krishna', handle: '@rahul_gamer', team: '🇧🇷 Brazil' },
                { initials: 'SN', name: 'Sajith Nair', handle: '@sajith_ef', team: '🇫🇷 France' },
                { initials: 'KV', name: 'Kiran Varma', handle: '@kiran_v', team: '🇵🇹 Portugal' }
            ];
        %>

        <% dummyPlayers.forEach(player => { %>
            <div class="bg-slate-900/40 backdrop-blur-md border border-white/5 rounded-[2rem] p-6 hover:border-emerald-500/30 transition-all group relative overflow-hidden flex flex-col justify-between h-52 shadow-xl">
                <!-- Card Glow -->
                <div class="absolute -top-10 -right-10 w-24 h-24 bg-emerald-500/5 blur-3xl group-hover:bg-emerald-500/10 transition-all"></div>
                
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 bg-emerald-500/10 rounded-2xl flex items-center justify-center border border-emerald-500/20 group-hover:scale-110 transition-transform">
                        <span class="text-emerald-400 text-lg font-black tracking-tighter"><%= player.initials %></span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="text-white font-bold text-base truncate group-hover:text-emerald-400 transition-colors"><%= player.name %></h4>
                        <p class="text-slate-500 text-xs font-medium"><%= player.handle %></p>
                        <p class="text-slate-400 text-[11px] mt-1 font-semibold flex items-center gap-1">
                            <%= player.team %>
                        </p>
                    </div>
                </div>

                <button class="w-full bg-slate-800/50 hover:bg-red-500/10 hover:text-red-400 text-slate-500 py-3 rounded-xl text-xs font-bold border border-white/5 hover:border-red-500/20 transition-all">
                    Remove Player
                </button>
            </div>
        <% }) %>

    </div>
</div>