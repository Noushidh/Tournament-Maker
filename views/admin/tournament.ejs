<div class="max-w-6xl mx-auto p-4 md:p-8 font-['Inter']">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <h2 class="text-3xl font-bold text-white tracking-tight">Tournaments</h2>
        <button id="openModalBtn"
            class="flex items-center justify-center gap-2 bg-emerald-400 hover:bg-emerald-500 text-gray-900 px-6 py-3 rounded-xl font-bold transition-all transform hover:scale-105 active:scale-95 shadow-lg shadow-emerald-400/20">

            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
            </svg>

            Create Tournament
        </button>
    </div>

    <div class="relative mb-10 group">
        <div
            class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-500 group-focus-within:text-emerald-400 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                    d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
            </svg>
        </div>
        <input type="text" placeholder="Search tournaments..."
            class="w-full bg-gray-900 border border-white/5 rounded-2xl py-4 pl-12 pr-4 text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400 transition-all">
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <div
            class="bg-gray-900 border border-white/5 rounded-2xl p-6 hover:border-emerald-400/30 transition-all group shadow-xl">
            <div class="flex justify-between items-start mb-6">
                <h3 class="text-xl font-bold text-white leading-tight">Kerala<br>eFootball Cup</h3>
                <span
                    class="px-3 py-1 bg-emerald-400/10 text-emerald-400 text-[10px] font-bold uppercase tracking-wider rounded-full border border-emerald-400/20">Active</span>
            </div>

            <div class="space-y-3 mb-8">
                <div
                    class="flex items-center gap-2 text-blue-400 bg-blue-400/5 w-fit px-2 py-1 rounded text-[11px] font-bold uppercase">
                    League
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    8 Players
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Jan 15, 2024
                </div>
            </div>

            <div class="flex gap-3">
                <button
                    class="flex-1 bg-white/5 hover:bg-white/10 text-white text-sm font-semibold py-2 rounded-lg transition-colors">View</button>
                <button
                    class="flex-1 bg-emerald-400/10 hover:bg-emerald-400/20 text-emerald-400 text-sm font-semibold py-2 rounded-lg transition-colors border border-emerald-400/20">Edit</button>
            </div>
        </div>

        <div
            class="bg-gray-900 border border-white/5 rounded-2xl p-6 hover:border-yellow-400/30 transition-all group shadow-xl">
            <div class="flex justify-between items-start mb-6">
                <h3 class="text-xl font-bold text-white leading-tight">Champions<br>League 2024</h3>
                <span
                    class="px-3 py-1 bg-yellow-400/10 text-yellow-400 text-[10px] font-bold uppercase tracking-wider rounded-full border border-yellow-400/20">Upcoming</span>
            </div>

            <div class="space-y-3 mb-8">
                <div
                    class="flex items-center gap-2 text-purple-400 bg-purple-400/5 w-fit px-2 py-1 rounded text-[11px] font-bold uppercase">
                    Knockout
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                    16 Players
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Feb 1, 2024
                </div>
            </div>

            <div class="flex gap-3">
                <button
                    class="flex-1 bg-white/5 hover:bg-white/10 text-white text-sm font-semibold py-2 rounded-lg transition-colors">View</button>
                <button
                    class="flex-1 bg-emerald-400/10 hover:bg-emerald-400/20 text-emerald-400 text-sm font-semibold py-2 rounded-lg transition-colors border border-emerald-400/20">Edit</button>
            </div>
        </div>

        <div
            class="bg-gray-900 border border-white/5 rounded-2xl p-6 hover:border-red-400/30 transition-all group shadow-xl">
            <div class="flex justify-between items-start mb-6">
                <h3 class="text-xl font-bold text-white leading-tight">Weekend<br>Warriors Cup</h3>
                <span
                    class="px-3 py-1 bg-red-400/10 text-red-400 text-[10px] font-bold uppercase tracking-wider rounded-full border border-red-400/20">Completed</span>
            </div>

            <div class="space-y-3 mb-8">
                <div
                    class="flex items-center gap-2 text-blue-400 bg-blue-400/5 w-fit px-2 py-1 rounded text-[11px] font-bold uppercase">
                    League
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                    12 Players
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Dec 20, 2023
                </div>
            </div>

            <div class="flex gap-3">
                <button
                    class="flex-1 bg-white/5 hover:bg-white/10 text-white text-sm font-semibold py-2 rounded-lg transition-colors">View</button>
                <button
                    class="flex-1 bg-emerald-400/10 hover:bg-emerald-400/20 text-emerald-400 text-sm font-semibold py-2 rounded-lg transition-colors border border-emerald-400/20">Edit</button>
            </div>
        </div>

    </div>
</div>
<%- include('../partials/modals/createTournament') %>

    <script>
        const openBtn = document.getElementById('openModalBtn');
        const modal = document.getElementById('tournamentModal');

        openBtn.addEventListener('click', () => {
            modal.classList.remove('hidden');
        });

        function closeModal() {
            modal.classList.add('hidden');
        }
    </script>