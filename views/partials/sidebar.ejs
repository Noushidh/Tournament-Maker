<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FOOTBALL Pro Sidebar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #030712;
        }

        /* Smooth transition for active indicators */
        .nav-link {
            transition: all 0.25s ease-in-out;
        }
    </style>
</head>

<body>

    <aside id="sidebar" class="w-64 h-screen bg-gray-900 border-r border-white/10 flex flex-col overflow-hidden">

        <div class="p-6 flex items-center gap-3">
            <div
                class="w-10 h-10 rounded-full bg-emerald-400/10 flex items-center justify-center border border-emerald-400/20 shadow-[0_0_15px_rgba(52,211,153,0.1)]">
                <svg class="w-6 h-6 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2">
                    <path d="m21 8-9-4-9 4V16l9 4 9-4V8z"></path>
                    <path d="m3 8 9 4 9-4"></path>
                    <path d="M12 12v8"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-slate-100 font-bold leading-none tracking-wide text-lg">FOOTBALL</h1>
                <span class="text-emerald-400 text-xs font-bold tracking-widest">PRO</span>
            </div>
        </div>

        <nav id="sidebar-nav" class="flex-1 px-4 py-4 space-y-2">

            <a href="/admin/dashboard"
                class="nav-link active-link group flex items-center gap-3 px-4 py-3 rounded-lg border-l-4 border-emerald-400 bg-white/5 text-emerald-400">
                <svg class="w-5 h-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <rect width="7" height="9" x="3" y="3" rx="1" />
                    <rect width="7" height="5" x="14" y="3" rx="1" />
                    <rect width="7" height="9" x="14" y="12" rx="1" />
                    <rect width="7" height="5" x="3" y="16" rx="1" />
                </svg>
                <span class="text-sm font-medium">Dashboard</span>
            </a>

            <a href="#"
                class="nav-link group flex items-center gap-3 px-4 py-3 rounded-lg border-l-4 border-transparent text-slate-400 hover:text-slate-100 hover:bg-white/5">
                <svg class="w-5 h-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
                    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" />
                    <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                </svg>
                <span class="text-sm font-medium">Tournaments</span>
            </a>

            <a href="#"
                class="nav-link group flex items-center gap-3 px-4 py-3 rounded-lg border-l-4 border-transparent text-slate-400 hover:text-slate-100 hover:bg-white/5">
                <svg class="w-5 h-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                </svg>
                <span class="text-sm font-medium">Players</span>
            </a>

            <a href="#"
                class="nav-link group flex items-center gap-3 px-4 py-3 rounded-lg border-l-4 border-transparent text-slate-400 hover:text-slate-100 hover:bg-white/5">
                <svg class="w-5 h-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <path d="M12 12v9" />
                    <path d="m15 15-3-3-3 3" />
                    <path d="m21 11-8-8c-.7-.7-1.3-.7-2 0l-8 8" />
                </svg>
                <span class="text-sm font-medium">Matches</span>
            </a>

            <a href="#"
                class="nav-link group flex items-center gap-3 px-4 py-3 rounded-lg border-l-4 border-transparent text-slate-400 hover:text-slate-100 hover:bg-white/5">
                <svg class="w-5 h-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3" />
                    <path
                        d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
                <span class="text-sm font-medium">Settings</span>
            </a>
        </nav>

        <div class="p-4 border-t border-white/5">
            <div
                class="p-4 bg-white/5 rounded-xl border border-white/10 hover:border-emerald-500/30 transition-all cursor-default">
                <p class="text-slate-100 text-[10px] font-bold uppercase tracking-widest mb-1">Pro League</p>
                <p class="text-slate-400 text-[10px] mb-4">Season 4 • 2026</p>
                <div class="w-full bg-white/10 h-1.5 rounded-full overflow-hidden">
                    <div class="bg-emerald-400 h-full w-[65%] rounded-full shadow-[0_0_10px_rgba(52,211,153,0.4)]">
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <script>
        const navLinks = document.querySelectorAll('.nav-link');

        navLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                // Prevent page refresh for demo
                e.preventDefault();

                // 1. Reset all links to inactive state
                navLinks.forEach(l => {
                    l.classList.remove('bg-white/5', 'text-emerald-400', 'border-emerald-400');
                    l.classList.add('text-slate-400', 'border-transparent');
                });

                // 2. Set clicked link to active state
                link.classList.add('bg-white/5', 'text-emerald-400', 'border-emerald-400');
                link.classList.remove('text-slate-400', 'border-transparent');
            });
        });
    </script>
</body>

</html>