<div id="deleteConfirmModal"
  class="hidden fixed inset-0 bg-black/80 backdrop-blur-md flex items-center justify-center z-[100] p-4 transition-all duration-300">

  <!-- Modal Box -->
  <div
    class="w-full max-w-sm bg-[#0f172a] rounded-[2rem] border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-8 text-center relative animate-in zoom-in duration-300">

    <!-- Icon -->
    <div class="mx-auto w-16 h-16 bg-red-500/10 rounded-2xl flex items-center justify-center border border-red-500/20 mb-6">
      <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
    </div>

    <!-- Content -->
    <h3 class="text-white text-xl font-bold mb-2">Remove Player?</h3>
    <p class="text-slate-400 text-sm mb-8 leading-relaxed">
      Are you sure you want to remove <span id="deletePlayerName" class="text-white font-bold"></span> from this tournament? This action cannot be undone.
    </p>

    <!-- Buttons -->
    <div class="flex flex-col gap-3">
        <form id="deleteForm" method="POST">
            <button type="submit" 
                class="w-full bg-red-500 hover:bg-red-400 text-white py-4 rounded-2xl text-sm font-bold transition-all shadow-[0_10px_30px_rgba(239,68,68,0.2)]">
                Yes, Remove Player
            </button>
        </form>
      <button onclick="closeDeleteModal()"
        class="w-full bg-slate-800/50 hover:bg-slate-800 text-slate-300 py-4 rounded-2xl text-sm font-bold border border-white/5 transition-all">
        Cancel
      </button>
    </div>
  </div>
</div>

<script>
  function closeDeleteModal() {
    document.getElementById('deleteConfirmModal').classList.add('hidden');
  }

  // Close on backdrop click
  document.getElementById('deleteConfirmModal').addEventListener('click', (e) => {
    if (e.target.id === 'deleteConfirmModal') closeDeleteModal();
  });
</script>
