<div id="tournamentModal"
  class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-50 p-4 transition-all duration-300">

  <!-- Modal Box -->
  <div
    class="w-full max-w-sm sm:max-w-md lg:max-w-lg bg-[#0f172a] rounded-2xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-6 sm:p-8 overflow-hidden relative">

    <!-- Decoration -->
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-lime-500 to-emerald-500"></div>

    <!-- Header -->
    <div class="mb-6 flex justify-between items-start">
      <div>
        <h2 id="modalTitle" class="text-white text-xl sm:text-2xl font-bold tracking-tight">Create Tournament</h2>
        <p class="text-emerald-500/80 text-[10px] sm:text-xs uppercase tracking-[0.2em] font-bold mt-1">Football
          Championship</p>
      </div>
      <button onclick="closeModal()" class="text-gray-500 hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Form -->
    <form id="tournamentForm" class="space-y-5">
      <input type="hidden" name="tournamentId" id="tournamentIdInput">
      
      <!-- Name -->
      <div class="space-y-1.5">
        <label class="text-gray-400 text-xs font-semibold uppercase tracking-wider ml-1">Tournament Name</label>
        <input type="text" name="name" id="nameInput" placeholder="e.g. Summer League 2024"
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder:text-gray-600 focus:outline-none focus:border-lime-500/50 focus:ring-1 focus:ring-lime-500/50 transition-all">
        <p id="nameError" class="text-red-400 text-[11px] mt-1 hidden flex items-center gap-1.5 ml-1">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
              clip-rule="evenodd"></path>
          </svg>
          <span></span>
        </p>
      </div>

      <!-- Tournament Format -->
      <div class="space-y-2">
        <label class="text-gray-400 text-xs font-semibold uppercase tracking-wider ml-1">Tournament Format</label>
        <div class="flex flex-wrap gap-2">
          <input type="hidden" name="type" id="formatInput" value="League">
          <button type="button" onclick="setFormat('League', this)"
            class="format-chip flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all border border-white/10 bg-lime-500 text-black shadow-[0_0_15px_rgba(132,204,22,0.2)]">
            League
          </button>
          <button type="button" onclick="setFormat('Knockout', this)"
            class="format-chip flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all border border-white/10 bg-white/5 text-gray-400 hover:bg-white/10">
            Knockout
          </button>
          <button type="button" onclick="setFormat('Groups + Knockout', this)"
            class="format-chip flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all border border-white/10 bg-white/5 text-gray-400 hover:bg-white/10">
            Groups + Knockout
          </button>
        </div>
      </div>

      <!-- Players -->
      <div class="space-y-1.5">
        <label class="text-gray-400 text-xs font-semibold uppercase tracking-wider ml-1">Players Count</label>
        <input type="number" id="playersInput" name="players" placeholder="Must be an even number"
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder:text-gray-600 focus:outline-none focus:border-lime-500/50 focus:ring-1 focus:ring-lime-500/50 transition-all">
        <p id="playersError" class="text-red-400 text-[11px] mt-1 hidden flex items-center gap-1.5 ml-1">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
              clip-rule="evenodd"></path>
          </svg>
          <span></span>
        </p>
      </div>

      <!-- Points System -->
      <div class="space-y-3 p-4 bg-white/5 rounded-xl border border-white/5">
        <label class="text-gray-400 text-xs font-semibold uppercase tracking-wider block">Points System</label>

        <div class="grid grid-cols-3 gap-3">
          <!-- Win -->
          <div class="space-y-1">
            <span class="text-gray-500 text-[10px] uppercase font-bold text-center block">Win</span>
            <input type="number" value="3" name="win" id="winInput"
              class="w-full bg-black/20 border border-white/10 rounded-lg px-2 py-2 text-white text-center focus:border-lime-500/50 outline-none transition-all">
          </div>

          <!-- Draw -->
          <div class="space-y-1">
            <span class="text-gray-500 text-[10px] uppercase font-bold text-center block">Draw</span>
            <input type="number" value="1" name="draw" id="drawInput"
              class="w-full bg-black/20 border border-white/10 rounded-lg px-2 py-2 text-white text-center focus:border-lime-500/50 outline-none transition-all">
          </div>

          <!-- Loss -->
          <div class="space-y-1">
            <span class="text-gray-500 text-[10px] uppercase font-bold text-center block">Loss</span>
            <input type="number" value="0" name="loss" id="lossInput"
              class="w-full bg-black/20 border border-white/10 rounded-lg px-2 py-2 text-white text-center focus:border-lime-500/50 outline-none transition-all">
          </div>
        </div>
        <p id="pointsError" class="text-red-400 text-[11px] mt-1 hidden flex items-center gap-1.5 ml-1">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
              clip-rule="evenodd"></path>
          </svg>
          <span></span>
        </p>
      </div>

      <!-- Date -->
      <div class="space-y-1.5">
        <label class="text-gray-400 text-xs font-semibold uppercase tracking-wider ml-1">Start Date</label>
        <input type="date" id="startDateInput" name="startDate"
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-lime-500/50 focus:ring-1 focus:ring-lime-500/50 [color-scheme:dark] transition-all">
        <p id="dateError" class="text-red-400 text-[11px] mt-1 hidden flex items-center gap-1.5 ml-1">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
              clip-rule="evenodd"></path>
          </svg>
          <span></span>
        </p>
      </div>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-4">
        <button type="button" onclick="closeModal()"
          class="w-full sm:flex-1 border border-white/10 text-gray-400 py-3 rounded-xl text-sm font-semibold hover:bg-white/5 hover:text-white transition-all">
          Cancel
        </button>

        <button type="submit" id="submitBtn"
          class="w-full sm:flex-1 bg-lime-500 text-black py-3 rounded-xl text-sm font-bold hover:bg-lime-400 transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
          <span id="btnText">Create Tournament</span>
          <svg id="loadingSpinner" class="w-5 h-5 animate-spin hidden" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none">
            </circle>
            <path class="opacity-75" fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
            </path>
          </svg>
        </button>
      </div>
    </form>
  </div>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed top-5 right-5 z-[100] flex flex-col gap-3"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("tournamentForm");
    const submitBtn = document.getElementById("submitBtn");
    const btnText = document.getElementById("btnText");
    const loadingSpinner = document.getElementById("loadingSpinner");
    const toastContainer = document.getElementById("toastContainer");

    const playersInput = document.getElementById("playersInput");
    const startDateInput = document.getElementById("startDateInput");
    const tournamentIdInput = document.getElementById("tournamentIdInput");
    const modalTitle = document.getElementById("modalTitle");

    // Helper: Show Toast
    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `flex items-center gap-3 px-6 py-4 rounded-xl shadow-2xl border transition-all duration-500 transform translate-x-full opacity-0 ${type === 'success'
        ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400'
        : 'bg-red-500/10 border-red-500/20 text-red-400'
        }`;

      const icon = type === 'success'
        ? '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>'
        : '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';

      toast.innerHTML = `${icon} <span class="font-semibold text-sm">${message}</span>`;
      toastContainer.appendChild(toast);

      // Animate in
      setTimeout(() => {
        toast.classList.remove('translate-x-full', 'opacity-0');
      }, 10);

      // Remove after 4s
      setTimeout(() => {
        toast.classList.add('translate-x-full', 'opacity-0');
        setTimeout(() => toast.remove(), 500);
      }, 4000);
    }

    // Helper: Show/Hide error
    function setError(id, message) {
      const errorEl = document.getElementById(id);
      const inputEl = document.querySelector(`[name="${id.replace('Error', '')}"]`) || document.getElementById(id.replace('Error', 'Input'));

      if (message) {
        errorEl.querySelector('span').textContent = message;
        errorEl.classList.remove('hidden');
        if (inputEl) inputEl.classList.add('border-red-500/50', 'ring-red-500/20');
      } else {
        errorEl.classList.add('hidden');
        if (inputEl) inputEl.classList.remove('border-red-500/50', 'ring-red-500/20');
      }
    }

    // Prevent past dates
    const todayStr = new Date().toISOString().split("T")[0];
    if (startDateInput) {
      startDateInput.setAttribute("min", todayStr);
    }

    // Helper: Set Tournament Format
    window.setFormat = (format, btn) => {
      if (typeof btn === 'string') {
          // If btn is just a string format, find the chip
          const chips = document.querySelectorAll('.format-chip');
          chips.forEach(chip => {
              if (chip.textContent.trim() === format) {
                  btn = chip;
              }
          });
      }
      
      document.getElementById('formatInput').value = format;

      // Reset all chips
      document.querySelectorAll('.format-chip').forEach(chip => {
        chip.classList.remove('bg-lime-500', 'text-black', 'shadow-[0_0_15px_rgba(132,204,22,0.2)]');
        chip.classList.add('bg-white/5', 'text-gray-400', 'hover:bg-white/10');
      });

      // Activate clicked chip
      if (btn) {
          btn.classList.add('bg-lime-500', 'text-black', 'shadow-[0_0_15px_rgba(132,204,22,0.2)]');
          btn.classList.remove('bg-white/5', 'text-gray-400', 'hover:bg-white/10');
      }
    };

    // Global function to open modal for editing
    window.openTournamentEditModal = (tournament) => {
        const modal = document.getElementById('tournamentModal');
        modal.classList.remove('hidden');
        
        // Change UI to Edit mode
        modalTitle.textContent = "Edit Tournament";
        btnText.textContent = "Update Tournament";
        
        // Fill form
        tournamentIdInput.value = tournament._id;
        document.getElementById('nameInput').value = tournament.name;
        document.getElementById('playersInput').value = tournament.players;
        document.getElementById('winInput').value = tournament.pointsSystem.win;
        document.getElementById('drawInput').value = tournament.pointsSystem.draw;
        document.getElementById('lossInput').value = tournament.pointsSystem.loss;
        
        const date = new Date(tournament.startDate).toISOString().split('T')[0];
        document.getElementById('startDateInput').value = date;
        
        window.setFormat(tournament.type);
    };

    // Reset modal on close
    const originalCloseModal = window.closeModal;
    window.closeModal = () => {
        form.reset();
        tournamentIdInput.value = "";
        modalTitle.textContent = "Create Tournament";
        btnText.textContent = "Create Tournament";
        window.setFormat('League', document.querySelector('.format-chip'));
        
        // Clear errors
        ['nameError', 'playersError', 'dateError', 'pointsError'].forEach(id => setError(id, null));
        
        const modal = document.getElementById('tournamentModal');
        if (modal) modal.classList.add('hidden');
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Clear previous errors
      ['nameError', 'playersError', 'dateError', 'pointsError'].forEach(id => setError(id, null));

      const formData = new FormData(form);
      const tournamentId = formData.get("tournamentId");
      const name = formData.get("name");
      const type = formData.get("type");
      const players = Number(formData.get("players"));
      const startDate = formData.get("startDate");

      const win = Number(formData.get("win"));
      const draw = Number(formData.get("draw"));
      const loss = Number(formData.get("loss"));

      let hasError = false;

      // Validation
      if (!name) {
        setError('nameError', "Tournament name is required");
        hasError = true;
      }

      if (!players || players <= 0) {
        setError('playersError', "Please enter a valid player count");
        hasError = true;
      } else if (players % 2 !== 0) {
        setError('playersError', "Players must be an even number");
        hasError = true;
      }

      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const selectedDate = new Date(startDate);
      selectedDate.setHours(0, 0, 0, 0);

      if (!startDate) {
        setError('dateError', "Start date is required");
        hasError = true;
      } else if (selectedDate < today) {
        setError('dateError', "Start date cannot be in the past");
        hasError = true;
      }

      // Points System Validation
      if (isNaN(win) || isNaN(draw) || isNaN(loss)) {
        setError('pointsError', "All points must be valid numbers");
        hasError = true;
      } else if (win < 0 || draw < 0 || loss < 0) {
        setError('pointsError', "Points cannot be negative");
        hasError = true;
      } else if (!Number.isInteger(win) || !Number.isInteger(draw) || !Number.isInteger(loss)) {
        setError('pointsError', "Points must be whole numbers");
        hasError = true;
      } else if (win > 10 || draw > 10 || loss > 10) {
        setError('pointsError', "Points cannot exceed 10");
        hasError = true;
      } else if (win <= draw || win <= loss) {
        setError('pointsError', "Win points must be greater than Draw and Loss");
        hasError = true;
      } else if (draw < loss) {
        setError('pointsError', "Draw points must be greater than or equal to Loss");
        hasError = true;
      }

      if (hasError) return;

      // Set Loading State
      submitBtn.disabled = true;
      const isEdit = !!tournamentId;
      btnText.textContent = isEdit ? "Updating..." : "Creating...";
      loadingSpinner.classList.remove("hidden");

      const data = {
        name,
        type,
        players,
        pointsSystem: {
          win: Number(formData.get("win")),
          draw: Number(formData.get("draw")),
          loss: Number(formData.get("loss"))
        },
        startDate
      };

      try {
        let res;
        if (isEdit) {
            res = await axios.post(`/admin/update-tournament/${tournamentId}`, data);
            showToast("Tournament updated successfully! ✅");
        } else {
            res = await axios.post("/admin/createtournament", data);
            showToast("Tournament created successfully! ✅");
        }
        
        setTimeout(() => {
          if (typeof closeModal === 'function') closeModal();
          if (isEdit) {
              window.location.reload();
          } else {
              const tournamentId = res.data.tournament._id;
              window.location.href = `/admin/add-members/${tournamentId}`;
          }
        }, 1000);
      } catch (err) {
        console.error(err);
        const errMsg = err.response?.data?.message || `Failed to ${isEdit ? 'update' : 'create'} tournament. Please try again.`;
        showToast(errMsg, 'error');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = isEdit ? "Update Tournament" : "Create Tournament";
        loadingSpinner.classList.add("hidden");
      }
    });
  });
</script>